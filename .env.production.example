# ── UNIBET360 PRODUCTION environment template ─────────────────────────
# Copy to .env on your server / set as Railway variables.
# Generate secrets:  openssl rand -hex 32

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/voltsbet"
NODE_ENV="production"
APP_URL="https://bet.example.com"      # public base URL (also used by the
                                       # Admin → Cronjobs config generator)

# ── Sports data (The Odds API v4) — the ONLY provider ────────────────
# Pre-match odds, live scores, live odds and settlement all run on
# the-odds-api.com. Free key = 500 req/month; paid tiers raise this.
ODDS_API_KEY=""
# Bookmaker region: free tier = us only; paid plans: us,eu (more books/leagues)
ODDS_API_REGIONS="eu,us"
# FULL league mapping: every bettable league the API lists is auto-mapped to
# a sport (curated SPORT_KEY_MAP + prefix fallback + sanitized key) — nothing
# is dropped. The odds pass is capped by ODDS_API_FEED_MAX_LEAGUES (default
# 120 — 1 request per league per run; ~80 active leagues on a paid plan).
# Free tier: set ODDS_API_FEED_MAX_LEAGUES low or ODDS_API_FALLBACK_LEAGUES.
# Markets — the /odds list endpoint serves h2h,spreads,totals; the rest
# (btts, double_chance, draw_no_bet, correct_score, half-time lines) is
# fetched per event from /events/{id}/odds for the leagues below (via
# ODDS_API_EVENT_BOOKMAKERS — Pinnacle confirmed). Unsupported markets are
# dropped gracefully; events with no data are skipped. Add h2h_h1, totals_h1,
# h2h_h2, totals_h2 when bookmaker coverage exists.
# ODDS_API_MARKETS="h2h,spreads,totals,btts,double_chance,draw_no_bet,correct_score,alternate_spreads,alternate_totals,h2h_h1,totals_h1,spreads_h1,h2h_h2,totals_h2,spreads_h2"
# Derived-markets engine (50+ lines from 1X2 math, zero provider cost) —
# disable with ENABLE_DERIVED_MARKETS=false
# ENABLE_DERIVED_MARKETS=true
# Per-event extended markets (1 credit per market per event — keep the limit
# small; 0 disables the pass):
# ODDS_API_EVENT_BOOKMAKERS="bovada,pinnacle"   # bovada primary (deepest board), pinnacle fallback
# ODDS_API_EVENT_MARKET_LEAGUES="soccer_epl,soccer_uefa_champs_league,soccer_italy_serie_a,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_france_ligue_one"
# ODDS_API_EVENT_MARKET_LIMIT=4    # max fixtures per league for the deep event pass (default 4)
# Markets for the in-play odds refresh on /live (h2h is the cheapest and
# universally priced; add more if your quota allows):
# ODDS_API_LIVE_MARKETS="h2h"
# Min seconds between in-play odds refreshes (separate from scores):
# LIVE_ODDS_THROTTLE_SECONDS=900
# Min seconds between live-score sweeps (per active league):
# LIVE_SCORES_THROTTLE_SECONDS=300

# ── Automated market rates (fiat + crypto) ─────────────────────────────
# /api/cron/rates pulls live rates from free, keyless sources
# (open.er-api.com base KES + CoinGecko) into the Currency table and
# settings cryptoRates — no manual admin entry needed.
# RATES_SYNC_THROTTLE_MINUTES=60

# ── Cron / automation ─────────────────────────────────────────────────
# Guards every /api/cron/* endpoint. Generate: openssl rand -hex 32
CRON_SECRET=""
# Min minutes between odds-sync runs (route self-throttles)
# SYNC_THROTTLE_MINUTES=60
# Min spacing between Odds API calls — free tier = 1 req/sec (1100ms);
# paid plans can lower to ~250
# ODDS_API_RATE_LIMIT_MS=1100
# Provider response cache TTL
# ODDS_API_CACHE_TTL_SECONDS=300
# Calendar purge: delete games kicked off this long ago (non-in-play)
# PURGE_MAX_AGE_HOURS=2

# ── M-Pesa (Palplus gateway) ────────────────────────────────────────────────
# Hard kill switch for the whole M-Pesa rail. When false (or unset), the
# M-Pesa tab is hidden on Deposit & Withdraw and users fall back to crypto.
ENABLE_MPESA_PAYMENTS="false"
# Withdrawal-side switch (env wins over the admin toggle).
# ENABLE_MPESA_WITHDRAWALS="false"
# Palpluss credentials are stored in Admin → Settings → M-Pesa (Palplus),
# not here: PALPLUS_API_KEY (starts with pp_live_ / pp_test_ — the key IS the
# auth: HTTP Basic, no token endpoint), PALPLUS_CHANNEL_ID (optional UUID —
# only needed when the console has no default channel), PALPLUS_WEBHOOK_SECRET
# (appended to callback URLs as ?secret= — callbacks without it are rejected),
# PALPLUS_ENV (sandbox|production; base https://api.palpluss.com/v1).
# Webhook: https://<app>/api/webhooks/palplus

# ── Seed (production) ────────────────────────────────────────────────────
# The seed script creates the super admin ONLY from these variables —
# the well-known dev password (Admin123!) is never a production fallback.
# In production a missing SEED_ADMIN_PASSWORD skips admin creation with a
# warning (alternative: run deploy/post-install.mjs to set admin creds).
# SEED_ADMIN_EMAIL="admin@unibet360.test"
# SEED_ADMIN_PASSWORD=""            # required in production when using the seed
# SEED_DEMO_USERS="false"           # "true" also seeds demo users in production

# ── IMPORTANT ─────────────────────────────────────────────────────────
# DO NOT set SHOW_SEEDED_GAMES in production — it reveals demo games.
# No BetsAPI / RapidAPI credentials are used anywhere in this stack.
