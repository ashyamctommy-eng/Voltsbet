# ── VoltBet PRODUCTION environment template ─────────────────────────
# Copy to .env on your server / set as Railway variables.
# Generate secrets:  openssl rand -hex 32

# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/voltsbet"
NODE_ENV="production"
APP_URL="https://bet.example.com"      # public base URL (also used by the
                                       # Admin → Cronjobs config generator)

# ── Data providers ───────────────────────────────────────────────────
# Pre-match odds — primary source. Free key = 500 req/month.
ODDS_API_KEY=""
# Bookmaker region: free tier = us only; paid plans: us,eu (more books/leagues)
ODDS_API_REGIONS="us"

# ── Cron / automation ─────────────────────────────────────────────────
# Guards every /api/cron/* endpoint. Generate: openssl rand -hex 32
CRON_SECRET=""
# Min minutes between odds-sync runs (route self-throttles)
# SYNC_THROTTLE_MINUTES=60
# Min spacing between Odds API calls — free tier = 1 req/sec (1100ms);
# paid plans can lower to ~250
# ODDS_API_RATE_LIMIT_MS=1100
# Provider response cache TTL
# ODDS_API_CACHE_TTL_SECONDS=300
# Calendar purge: delete games kicked off this long ago (non-in-play)
# PURGE_MAX_AGE_HOURS=2

# ── IMPORTANT ─────────────────────────────────────────────────────────
# DO NOT set SHOW_SEEDED_GAMES in production — it reveals demo games.
# BetsAPI credentials go in Admin → API Settings (DB-stored), NOT here.
