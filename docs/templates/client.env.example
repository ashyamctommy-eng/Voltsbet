# ── Per-client environment template (Fleet model) ─────────────────────────
# Copy per client, fill the marked values, paste into Railway → Variables
# (or a VPS .env). Full reference: .env.example · operations: docs/SAAS-PLAYBOOK.md
#
# REQUIRED minimum: DATABASE_URL, APP_URL, CRON_SECRET, ODDS_API_KEY.
# Everything else is optional and can be changed later in the admin UI —
# env only OVERRIDES the DB settings.

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://…"        # Railway Postgres plugin injects this
NODE_ENV="production"
APP_URL="https://bet.client.tld"     # this client's domain
CRON_SECRET=""                       # openssl rand -hex 32  (UNIQUE per client)

# ── Sports data — the client's own key, never the platform's ──────────────
ODDS_API_KEY=""                      # https://the-odds-api.com (their plan/quota)
ODDS_API_REGIONS="eu"                # eu = Pinnacle (football-first, 3 credits/league)

# ── First super admin (used once by `prisma db seed`) ─────────────────────
SEED_ADMIN_EMAIL="ops@client.tld"
SEED_ADMIN_PASSWORD=""               # temp; rotate after handover
# SEED_DEMO_USERS="false"            # never seed demo users in production

# ── Display / product defaults (all overridable in the admin UI) ──────────
SHOW_SEEDED_GAMES="false"            # hide demo (MANUAL) rows site-wide
BETSLIP_AUTO_OPEN="false"            # false = picking a price is silent
BROADCAST_TTL_HOURS="72"             # banner auto-hide (0 = never)
# LIVE_ET_SETTLE="auto"              # settle knockouts on the full result
# LIVE_FEED_FRESH_MINUTES="30"       # hide live rows the feed stopped reporting

# ── Payments (client's merchant accounts) ─────────────────────────────────
# PALPLUS_BASE_URL=""
# ENABLE_MPESA_PAYMENTS="true"       # admin auto-enables once a key is saved
# ENABLE_MPESA_WITHDRAWALS="true"

# ── Settlement stats feed (API-Football) — optional, off by default ───────
# Enables auto-settlement of corners/cards + half-time markets.
# API_FOOTBALL_KEY=""                # the CLIENT'S api-sports.io key (free tier OK)
# STATS_PROVIDER="api-football"      # or leave unset and enable in the admin UI
# STATS_DAILY_BUDGET="90"            # hard ceiling (free tier = 100/day)

# ── Anti-abuse ────────────────────────────────────────────────────────────
# RECAPTCHA_SECRET_KEY=""
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# ── Quiet knobs (only touch if you know why) ──────────────────────────────
# SYNC_THROTTLE_MINUTES="60"         # paid pre-match pass throttle
# LIVE_SCORES_THROTTLE_SECONDS="300"
# ODDS_API_EVENT_MARKET_LIMIT="4"
# ODDS_API_EVENT_MARKET_LEAGUES="soccer_epl,soccer_uefa_champs_league"
# SOCCER_DETAIL_MARKETS="alternate_totals,alternate_spreads,h2h_h1,h2h_h2,team_totals,corners_1x2,alternate_totals_corners"
# SOCCER_DETAIL_CACHE_TTL_SECONDS="45"
