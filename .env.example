DATABASE_URL="file:./dev.db"

# ── Sports data (The Odds API v4) — the ONLY provider ──────────────────
# Get a key (500 req/month free, paid tiers for higher volume):
# https://the-odds-api.com — powers pre-match odds, live scores AND
# settlement. No other provider is used.
ODDS_API_KEY=
# Bookmaker region: free tier = us only; paid plans add eu/uk/au
ODDS_API_REGIONS=eu
# ODDS_API_FALLBACK_LEAGUES=soccer_epl,soccer_spain_la_liga  # preferred feed leagues (1 credit each); empty = ALL active soccer leagues
# ODDS_API_FEED_MAX_LEAGUES=120      # max leagues per odds/schedule pass (1 request each) — full mapping
#                                   syncs EVERY active league by default; free tier: lower it (e.g. 10)

# ── Live pipeline (also The Odds API) ──────────────────────────────────
# Live scores/status come from GET /v4/sports/{sport}/scores?daysFrom=1,
# throttled to one sweep per active league per window (default 5 min).
# LIVE_SCORES_THROTTLE_SECONDS=300   # min seconds between live-score sweeps
# In-play odds are refreshed separately from /odds (1 credit per market per
# league per refresh; h2h default keeps it cheap):
# ODDS_API_LIVE_MARKETS="h2h"
# LIVE_ODDS_THROTTLE_SECONDS=900     # min seconds between live-odds refreshes
# ── Derived-markets engine ──────────────────────────────────────────────
# Auto-generates 50+ bettable lines per priced 1X2 fixture (Double Chance,
# DNB, BTTS, alternate totals/spreads, team totals, half-time lines, goal
# parity) via Poisson math — zero provider requests, zero manual input.
# ENABLE_DERIVED_MARKETS=false   # disable the engine
# ── Per-event extended markets (btts, correct_score, double_chance, …) ─
# Fetched from /events/{id}/odds for the nearest fixtures of the leagues
# below; 1 credit per market per event (keep the limit small).
# ODDS_API_EVENT_BOOKMAKERS="pinnacle"
# ODDS_API_EVENT_MARKET_LEAGUES="soccer_epl,soccer_uefa_champs_league"
# ODDS_API_EVENT_MARKET_LIMIT=3

# ── Automated market rates ─────────────────────────────────────────────
# /api/cron/rates pulls live fiat + crypto rates (no key needed).
# RATES_SYNC_THROTTLE_MINUTES=60

# ── Games display ────────────────────────────────────────────────────────
# Kill switch for seed/demo (MANUAL) games. false = show only synced (API)
# games site-wide. Overrides the Admin → Odds & Risk toggle when set.
SHOW_SEEDED_GAMES=false

# ── M-Pesa (Palpluss) ──────────────────────────────────────────────────────
# ENABLE_MPESA_PAYMENTS=true   # false hides the M-Pesa tab on Deposit/Withdraw
# Palpluss keys live in Admin → Settings → M-Pesa (Palplus). Keys start with
# pk_live_/pk_test_; auth is HTTP Basic (the key is the username, no password)
# against https://api.palpluss.com/v1 (sandbox: https://sandbox.palpluss.com/v1).

# ── Seed (local dev) ─────────────────────────────────────────────────────
# Local dev defaults: admin@voltbet.test / Admin123! + demo users are seeded.
# Override to test production seed behavior:
# SEED_ADMIN_EMAIL=admin@voltbet.test
# SEED_ADMIN_PASSWORD=SomeStrongPass
# SEED_DEMO_USERS=false

# ── Payments (set in Admin → Website Settings once deployed) ────────────
# Public HTTPS URL of the app — used to build webhook callback URLs
APP_URL=
