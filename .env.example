DATABASE_URL="file:./dev.db"

# ── Sports data (The Odds API v4) — the ONLY provider ──────────────────
# Get a key (500 req/month free, paid tiers for higher volume):
# https://the-odds-api.com — powers pre-match odds, live scores AND
# settlement. No other provider is used.
ODDS_API_KEY=
# Bookmaker region(s). Each EXTRA region DOUBLES the cost of every request, so
# keep one unless you specifically need US books:  eu | us | eu,us
ODDS_API_REGIONS=eu
# ODDS_API_FALLBACK_LEAGUES=soccer_epl,soccer_spain_la_liga  # preferred feed leagues (1 credit each); empty = ALL active soccer leagues
# ODDS_API_FEED_MAX_LEAGUES=120      # max leagues per odds/schedule pass (1 request each) — full mapping
#                                   syncs EVERY active league by default; free tier: lower it (e.g. 10)

# ── Live pipeline (also The Odds API) ──────────────────────────────────
# Live scores/status come from GET /v4/sports/{sport}/scores?daysFrom=1,
# throttled to one sweep per active league per window (default 5 min).
# LIVE_SCORES_THROTTLE_SECONDS=300   # min seconds between live-score sweeps
# In-play odds are refreshed separately from /odds (1 credit per market per
# league per refresh; h2h default keeps it cheap):
# ODDS_API_LIVE_MARKETS="h2h"
# LIVE_ODDS_THROTTLE_SECONDS=900     # min seconds between live-odds refreshes
# ── Derived-markets engine ──────────────────────────────────────────────
# Auto-generates 50+ bettable lines per priced 1X2 fixture (Double Chance,
# DNB, BTTS, alternate totals/spreads, team totals, half-time lines, goal
# parity) via Poisson math — zero provider requests, zero manual input.
# ENABLE_DERIVED_MARKETS=false   # disable the engine
# ── Per-event extended markets (btts, correct_score, double_chance, …) ─
# Fetched from /events/{id}/odds for the nearest fixtures of the leagues
# below; 1 credit per market per event (keep the limit small).
# ODDS_API_EVENT_BOOKMAKERS="bovada,pinnacle"   # bovada primary, pinnacle fallback
# ODDS_API_EVENT_MARKET_LEAGUES="soccer_epl,soccer_uefa_champs_league"
# ODDS_API_EVENT_MARKET_LIMIT=4    # max fixtures per league (default 4)

# ── Credit guard (recommended) ──────────────────────────────────────────
# One sync costs ≈ leagues × listMarkets × regions
#                + eventLeagues × EVENT_MARKET_LIMIT × extendedMarkets × regions
# (the per-event deep-market pass usually dominates and is independent of how
# many leagues you sync). A run whose estimate exceeds this cap ABORTS before
# the paid pass — nothing is fetched, nothing is spent. Unset = no cap, and a
# broad sweep can spend unchecked. See Admin → API Settings → Credits for the
# live estimate of the current config.
# MAX_CREDITS_PER_RUN=400

# ── Payment reconciliation (missed-webhook safety net) ──────────────────
# /api/cron/reconcile re-checks open M-Pesa (PalPluss) and crypto (NOWPayments)
# deposits straight from the provider when a webhook was lost. 0 quota cost.
# RECONCILE_THROTTLE_MINUTES=5

# ── Automated market rates ─────────────────────────────────────────────
# /api/cron/rates pulls live fiat + crypto rates (no key needed).
# RATES_SYNC_THROTTLE_MINUTES=60

# ── Games display ────────────────────────────────────────────────────────
# Kill switch for seed/demo (MANUAL) games. false = show only synced (API)
# games site-wide. Overrides the Admin → Odds & Risk toggle when set.
SHOW_SEEDED_GAMES=false

# ── M-Pesa (Palpluss) ──────────────────────────────────────────────────────
# ENABLE_MPESA_PAYMENTS=true   # false hides the M-Pesa tab on Deposit/Withdraw
# Palpluss keys live in Admin → Settings → M-Pesa (Palplus). Keys start with
# pk_live_/pk_test_; auth is HTTP Basic (the key is the username, no password)
# against https://api.palpluss.com/v1 (sandbox: https://sandbox.palpluss.com/v1).

# ── Seed (local dev) ─────────────────────────────────────────────────────
# Local dev defaults: admin@voltbets.test / Admin123! + demo users are seeded.
# Override to test production seed behavior:
# SEED_ADMIN_EMAIL=admin@voltbets.test
# SEED_ADMIN_PASSWORD=SomeStrongPass
# SEED_DEMO_USERS=false

# ── Payments (set in Admin → Website Settings once deployed) ────────────
# Public HTTPS URL of the app — used to build webhook callback URLs
APP_URL=

# ── Bot protection (Google reCAPTCHA v2 checkbox) ─────────────────────
# Optional — set BOTH keys to require "I'm not a robot" on /register and
# /login (widget renders + server verifies every token via siteverify).
# Create keys: https://www.google.com/recaptcha/admin → v2 "I'm not a robot".
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Settlement stats feed (API-Football / api-sports.io) ──────────────────
# Supplies corners, cards and half-time scores for AUTO-SETTLEMENT of markets
# the score feed can't resolve. Off by default; enable in Admin → API Settings
# (or set STATS_PROVIDER here). Free tier = 100 requests/day, stats available
# for today → +2 days only; paid plans remove the date/season limits.
# API_FOOTBALL_KEY=            # or paste it in the admin card (env wins)
# STATS_PROVIDER=api-football  # off | api-football
# STATS_DAILY_BUDGET=90        # our hard ceiling (leave headroom under 100)
# STATS_RATE_LIMIT_MS=6500     # free tier allows 10 requests/minute
# STATS_PASS_THROTTLE_SECONDS=600   # min gap between settlement passes
# STATS_LIST_TTL_SECONDS=900        # matchday fixture list cache (1 call per matchday)
# STATS_MAX_GAMES_PER_PASS=12       # burst guard — max games enriched per pass

# ── Maintenance kill-switch ───────────────────────────────────────────────
# Set to 1 (or true) to put the whole site into a branded maintenance screen:
# pages are rewritten to /maintenance, API calls get a 503 JSON. Works even if
# the database is down (the proxy is dependency-free). /api/health, cron and
# payment webhooks stay live. Unset + redeploy to restore.
# MAINTENANCE_MODE=
