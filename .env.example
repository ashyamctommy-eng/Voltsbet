DATABASE_URL="file:./dev.db"

# ── Sports data (The Odds API) ─────────────────────────────────────────
# Get a free key (500 req/month, no card): https://the-odds-api.com
ODDS_API_KEY=
# Bookmaker region: free tier = us only; paid plans add eu/uk/au
ODDS_API_REGIONS=us

# ── Sports data (Odds-API.io / API-Football v3) ────────────────────────
# Alternate provider — global + African football, no region locks.
# Get a free key (100 req/day, no card): https://dashboard.api-football.com
# Switch via Admin → Settings → Odds & Risk → odds.provider = api-football
ODDS_API_IO_KEY=
# Optional knobs (defaults are free-tier friendly):
# ODDS_API_IO_DAYS_AHEAD=7          # upcoming window in days (fixtures+odds)
# ODDS_API_IO_MAX_ODDS_PAGES=3      # /odds pages per day (10 fixtures/page)

# ── Sports data (Odds-API.io — api.odds-api.io/v3) ─────────────────────
# The company at odds-api.io (not the same as API-Football above).
# Free plan: 2 recreational bookmakers, 100 req/hour — no card.
# Key + bookmaker selection: https://odds-api.io/dashboard
# Switch via Admin → Settings → Odds & Risk → odds.provider = odds-api-io
ODDS_IO_KEY=
# Optional knobs:
# ODDS_IO_MAX_EVENTS=150            # max pending events imported per sync
# ODDS_IO_BOOKMAKERS=1xbet,22Bet    # override account's selected bookmakers

# ── Games display ────────────────────────────────────────────────────────
# Kill switch for seed/demo (MANUAL) games. false = show only synced (API)
# games site-wide. Overrides the Admin → Odds & Risk toggle when set.
SHOW_SEEDED_GAMES=false

# ── Primary API (Bet365 via RapidAPI / BetsAPI) ──────────────────────────
# Credentials are stored in the DB via Admin → API Settings (no env needed).
# X-RapidAPI-Key from https://rapidapi.com/betsapi and the betsapi package.
# Optional knobs (BASIC plan is rate-limited per hour — keep these modest):
# BETSAPI_MAX_EVENTS=150            # max upcoming fixtures per sync
# BETSAPI_ODDS_EVENTS=20            # events that get prematch odds (1 req each)
# BETSAPI_RESULT_SWEEP=20           # finished-result lookups per sync (1 req each)

# ── Payments (set in Admin → Website Settings once deployed) ────────────
# Public HTTPS URL of the app — used to build webhook callback URLs
APP_URL=
